-# Ask RidePilot: help chat on every page (HelpController#ask, HelpAssistant).
-# Answers come from docs/help/*.md; it can't see or change RidePilot data.
:css
  #askrp-button { position: fixed; right: 18px; bottom: 44px; z-index: 1500; border-radius: 22px; padding: 9px 16px;
    background: #1f3864; color: #fff; border: 0; box-shadow: 0 3px 12px rgba(0,0,0,.25); font-weight: 600; }
  #askrp-button:hover, #askrp-button:focus { background: #2b4c86; color: #fff; }
  #askrp-panel { position: fixed; right: 18px; bottom: 44px; z-index: 1600; width: 380px; max-width: calc(100vw - 36px);
    height: 520px; max-height: calc(100vh - 90px); display: none; flex-direction: column; background: #fff;
    border: 1px solid #c9d2df; border-radius: 8px; box-shadow: 0 8px 30px rgba(0,0,0,.28); }
  #askrp-panel.open { display: flex; }
  #askrp-button, #askrp-panel .askrp-head { touch-action: none; user-select: none; }
  #askrp-button { cursor: grab; }
  #askrp-panel .askrp-head { cursor: move; }
  #askrp-button.dragging, #askrp-panel .askrp-head.dragging { cursor: grabbing; }
  #askrp-panel .askrp-head { background: #1f3864; color: #fff; padding: 10px 14px; border-radius: 8px 8px 0 0;
    display: flex; align-items: center; justify-content: space-between; }
  #askrp-panel .askrp-head strong { font-size: 15px; }
  #askrp-panel .askrp-head button { background: none; border: 0; color: #fff; font-size: 20px; line-height: 1; }
  #askrp-panel .askrp-head button#askrp-new { font-size: 12px; border: 1px solid rgba(255,255,255,.5); border-radius: 12px; padding: 2px 9px; margin-right: 8px; }
  #askrp-log { flex: 1; overflow-y: auto; padding: 12px 14px; font-size: 13.5px; }
  #askrp-log .msg { margin: 0 0 10px; padding: 8px 11px; border-radius: 8px; line-height: 1.45; word-wrap: break-word; }
  #askrp-log .msg.user { background: #e8eef8; margin-left: 40px; }
  #askrp-log .msg.bot { background: #f6f7f9; border: 1px solid #e3e6ea; margin-right: 12px; }
  #askrp-log .msg.bot ol, #askrp-log .msg.bot ul { padding-left: 20px; margin: 4px 0; }
  #askrp-log .msg.err { background: #fdecea; color: #8a1f11; }
  #askrp-log .askrp-feedback { font-size: 12px; color: #777; margin: -4px 0 10px 2px; }
  #askrp-log .askrp-feedback button { background: none; border: 1px solid #ccd; border-radius: 12px; padding: 1px 8px; margin-left: 4px; }
  #askrp-log .askrp-feedback button.picked { background: #1f3864; color: #fff; border-color: #1f3864; }
  #askrp-panel .askrp-suggest { padding: 0 14px 6px; }
  #askrp-panel .askrp-suggest button { display: block; width: 100%; text-align: left; margin: 0 0 5px; padding: 6px 9px;
    font-size: 12.5px; background: #fff; border: 1px solid #c9d2df; border-radius: 6px; color: #1f3864; }
  #askrp-panel form { display: flex; gap: 6px; padding: 8px 10px 10px; border-top: 1px solid #e3e6ea; }
  #askrp-panel textarea { flex: 1; resize: none; height: 54px; font-size: 13.5px; padding: 6px 8px; border: 1px solid #c9d2df; border-radius: 6px; }
  #askrp-panel .askrp-note { font-size: 11px; color: #888; padding: 0 12px 8px; }

%button#askrp-button{type: "button", title: "Ask a question about using RidePilot (drag to move)"}
  %i.fa.fa-question-circle
  Ask RidePilot
#askrp-panel{role: "dialog", "aria-label": "Ask RidePilot"}
  .askrp-head
    %strong{title: "Drag to move"}
      %i.fa.fa-question-circle
      Ask RidePilot
    %span
      %button#askrp-new{type: "button", title: "Clear this conversation and start over"} New chat
      %button#askrp-close{type: "button", title: "Close"} &times;
  #askrp-log{"aria-live": "polite"}
    .msg.bot#askrp-hello
      Hi! Ask me how to do something in RidePilot: booking trips, dispatching, runs, fares, customers, drivers. I explain; I can't see or change your data.
  .askrp-suggest#askrp-suggest
    %button{type: "button"} How do I put a trip on a run?
    %button{type: "button"} How do I set a rider's fare category?
    %button{type: "button"} What does "Trip schedule does not fit in run schedule" mean?
  %form#askrp-form
    %textarea#askrp-input{placeholder: "Type your question (English or Spanish)...", "aria-label": "Your question"}
    %button.btn.btn-primary{type: "submit"} Ask
  .askrp-note Answers come from GCRPC's RidePilot guide and can be wrong. For anything important, check with Kristie or GCRPC I.T.

:javascript
  (function() {
    var ASK_URL = #{help_ask_path.to_json}, FEEDBACK_URL = #{help_feedback_path(id: "ID").to_json};
    var panel = document.getElementById('askrp-panel'), button = document.getElementById('askrp-button');
    var log = document.getElementById('askrp-log'), form = document.getElementById('askrp-form');
    var input = document.getElementById('askrp-input'), suggest = document.getElementById('askrp-suggest');
    var busy = false;

    // The conversation follows the user from page to page (a step often says
    // "go to Customers"), for as long as the browser tab is open. It is kept
    // per signed-in user, so someone else signing in on the same tab starts clean.
    var CHAT_KEY = 'askrp.chat.' + #{current_user.id.to_json}, OPEN_KEY = 'askrp.open';
    function tabGet(key) { try { return JSON.parse(sessionStorage.getItem(key) || 'null'); } catch (e) { return null; } }
    function tabSet(key, v) { try { v ? sessionStorage.setItem(key, JSON.stringify(v)) : sessionStorage.removeItem(key); } catch (e) {} }
    try { Object.keys(sessionStorage).forEach(function(k) { if (k.indexOf('askrp.chat.') === 0 && k !== CHAT_KEY) sessionStorage.removeItem(k); }); } catch (e) {}
    var chat = tabGet(CHAT_KEY) || [];   // [{cls: 'user'|'bot'|'err', text, id?, helpful?}]
    function saveChat() { chat = chat.slice(-40); tabSet(CHAT_KEY, chat.length ? chat : null); }
    // the last few question/answer turns, which the model sees as context
    function recentTurns() {
      return chat.filter(function(m) { return m.cls !== 'err'; }).slice(-6)
                 .map(function(m) { return { role: m.cls === 'user' ? 'user' : 'assistant', content: m.text }; });
    }

    function open(focus) {
      panel.classList.add('open'); button.style.display = 'none'; tabSet(OPEN_KEY, true);
      place(panel, recall('askrp.panel')); log.scrollTop = log.scrollHeight;
      if (focus) input.focus();
    }
    function close() { panel.classList.remove('open'); button.style.display = ''; tabSet(OPEN_KEY, null); }
    button.addEventListener('click', function(e) { if (button.dataset.dragged) { delete button.dataset.dragged; return; } open(true); });
    document.getElementById('askrp-close').addEventListener('click', close);

    // Drag the button, or the panel by its header, out of the way. Where each
    // was dropped is kept per browser and held inside the window.
    function store(key, v) { try { v ? localStorage.setItem(key, JSON.stringify(v)) : localStorage.removeItem(key); } catch (e) {} }
    function recall(key) { try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch (e) { return null; } }
    function place(el, pos) {
      if (!pos) return;
      var w = el.offsetWidth || 160, h = el.offsetHeight || 40;
      el.style.left = Math.max(0, Math.min(pos.left, window.innerWidth - w)) + 'px';
      el.style.top = Math.max(0, Math.min(pos.top, window.innerHeight - h)) + 'px';
      el.style.right = 'auto'; el.style.bottom = 'auto';
    }
    function draggable(el, handle, key) {
      handle.addEventListener('pointerdown', function(e) {
        if (e.button !== 0 || e.target.closest('#askrp-close')) return;
        var r = el.getBoundingClientRect(), sx = e.clientX, sy = e.clientY, moved = false;
        function move(ev) {
          if (!moved && Math.abs(ev.clientX - sx) + Math.abs(ev.clientY - sy) < 6) return;
          moved = true; handle.classList.add('dragging');
          place(el, { left: r.left + ev.clientX - sx, top: r.top + ev.clientY - sy });
        }
        function up() {
          document.removeEventListener('pointermove', move); document.removeEventListener('pointerup', up);
          handle.classList.remove('dragging');
          if (moved) { el.dataset.dragged = '1'; store(key, { left: parseFloat(el.style.left), top: parseFloat(el.style.top) }); }
        }
        document.addEventListener('pointermove', move); document.addEventListener('pointerup', up);
      });
      place(el, recall(key));
      window.addEventListener('resize', function() { place(el, recall(key)); });
    }
    draggable(button, button, 'askrp.button');
    draggable(panel, panel.querySelector('.askrp-head'), 'askrp.panel');

    function esc(s) { return s.replace(/[&<>"]/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    // plain text with **bold**, *italics*, numbered and bulleted lists; steps
    // keep their numbers when bullets sit between them (1, 2, 3, bullets, 4)
    function render(text) {
      var out = [], list = null, stepsSoFar = 0;
      esc(text).split('\n').forEach(function(line) {
        var num = line.match(/^\s*\d+[.)]\s+(.*)/), bul = line.match(/^\s*[-*•]\s+(.*)/);
        var kind = num ? 'ol' : (bul ? 'ul' : null);
        if (list && list !== kind) { out.push('</' + list + '>'); list = null; }
        if (kind) {
          if (!list) { out.push(kind === 'ol' && stepsSoFar ? '<ol start="' + (stepsSoFar + 1) + '">' : '<' + kind + '>'); list = kind; }
          if (kind === 'ol') stepsSoFar++;
          out.push('<li>' + (num || bul)[1] + '</li>');
        } else if (line.trim()) { out.push('<div>' + line + '</div>'); stepsSoFar = 0; }
      });
      if (list) out.push('</' + list + '>');
      return out.join('').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/(^|[^*])\*([^*]+?)\*(?!\*)/g, '$1<em>$2</em>');
    }
    function add(cls, html) {
      var d = document.createElement('div'); d.className = 'msg ' + cls; d.innerHTML = html;
      log.appendChild(d); log.scrollTop = log.scrollHeight; return d;
    }
    function feedbackFor(msg) {
      var f = document.createElement('div'); f.className = 'askrp-feedback';
      f.innerHTML = 'Was this helpful? <button type="button" data-v="true">&#128077; Yes</button><button type="button" data-v="false">&#128078; No</button>';
      if (msg.helpful) f.querySelector('[data-v="' + msg.helpful + '"]').classList.add('picked');
      var id = msg.id;
      f.addEventListener('click', function(e) {
        var b = e.target.closest('button'); if (!b) return;
        f.querySelectorAll('button').forEach(function(x) { x.classList.remove('picked'); }); b.classList.add('picked');
        msg.helpful = b.dataset.v; saveChat();
        var body = new FormData(); body.append('helpful', b.dataset.v);
        fetch(FEEDBACK_URL.replace('ID', id), { method: 'POST', body: body, credentials: 'same-origin',
          headers: { 'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content } });
      });
      log.appendChild(f); log.scrollTop = log.scrollHeight;
    }

    async function ask(question) {
      if (busy || !question.trim()) return;
      busy = true; suggest.style.display = 'none'; input.value = '';
      add('user', esc(question));
      var bot = add('bot', '<em>Thinking…</em>'), answer = '', doneId = null, failed = null;
      var body = new FormData();
      body.append('question', question); body.append('history', JSON.stringify(recentTurns()));
      body.append('page_path', location.pathname); body.append('page_title', document.title);
      try {
        var res = await fetch(ASK_URL, { method: 'POST', body: body, credentials: 'same-origin',
          headers: { 'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content, 'Accept': 'text/event-stream' } });
        if (!res.ok || !res.body) throw new Error('HTTP ' + res.status);
        var reader = res.body.getReader(), decoder = new TextDecoder(), buf = '';
        while (true) {
          var chunk = await reader.read(); if (chunk.done) break;
          buf += decoder.decode(chunk.value, { stream: true });
          var parts = buf.split('\n\n'); buf = parts.pop();
          parts.forEach(function(p) {
            var line = p.replace(/^data:\s*/, ''); if (!line) return;
            var ev; try { ev = JSON.parse(line); } catch (e) { return; }
            if (ev.t) { answer += ev.t; bot.innerHTML = render(answer); log.scrollTop = log.scrollHeight; }
            if (ev.done) doneId = ev.id;
            if (ev.error) failed = ev.error;
          });
        }
      } catch (e) { failed = "Ask RidePilot can't answer right now. Try again in a minute, or ask Kristie or GCRPC I.T."; }
      if (failed && !answer) {
        bot.className = 'msg err'; bot.textContent = failed;
        chat.push({ cls: 'user', text: question }, { cls: 'err', text: failed });
      } else {
        var msg = { cls: 'bot', text: answer, id: doneId };
        chat.push({ cls: 'user', text: question }, msg);
        if (doneId) feedbackFor(msg);
      }
      saveChat();
      busy = false; input.focus();
    }

    function show(m) {
      add(m.cls, m.cls === 'bot' ? render(m.text) : esc(m.text));
      if (m.cls === 'bot' && m.id) feedbackFor(m);
    }
    document.getElementById('askrp-new').addEventListener('click', function() {
      if (busy) return;
      chat = []; saveChat();
      Array.prototype.slice.call(log.children).forEach(function(el) { if (el.id !== 'askrp-hello') log.removeChild(el); });
      suggest.style.display = ''; input.value = ''; input.focus();
    });
    // pick up where the user left off on the previous page
    if (chat.length) { suggest.style.display = 'none'; chat.forEach(show); }
    if (tabGet(OPEN_KEY)) open(false);
    form.addEventListener('submit', function(e) { e.preventDefault(); ask(input.value); });
    input.addEventListener('keydown', function(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask(input.value); } });
    suggest.addEventListener('click', function(e) { var b = e.target.closest('button'); if (b) ask(b.textContent); });
  })();

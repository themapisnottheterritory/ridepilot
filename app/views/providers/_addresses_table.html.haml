-# Names used by places in more than one town ("Dialysis" in Victoria,
-# Cuero and Edna): each says which other towns, and the box lists only those.
%label{style: 'font-weight: normal;'}
  %input#same-name-only{type: 'checkbox'}
  Only names used in more than one town
  %span.text-muted= "(#{@other_towns.size})" if @other_towns
%table.table.table-bordered#address_results
  %thead
    %tr
      -# Holds the address group, which is where the counties live -- not a "type".
      -# The eight actual place categories (Medical, Dialysis, Senior Center ...) share
      -# this field and have nothing assigned to them, so naming it honestly is the
      -# least this column can do until that is untangled.
      %th= translate_helper("address_group")
      %th= translate_helper("address_results_name_column")
      %th= translate_helper("address")
      %th Town
      -# State was dropped -- all 2,788 provider addresses are TX, so the column
      -# only ever repeated itself. County took the space once it stopped sharing
      -# a field with the address type and got a column of its own.
      %th= translate_helper("county")
      %th= translate_helper("phone_number")
      %th= translate_helper("in_district")
      %th= translate_helper("address_notes")
      - if can? :edit, Address
        %th
  %tbody
    = render partial: 'addresses/provider_common_address', collection: @addresses, as: :address,
      locals: { row_context: provider_common_address_row_context }

:javascript
  $(function() {
    $.fn.dataTableExt.afnFiltering.push(function(settings, data, i) {
      if (settings.nTable.id !== 'address_results' || !$('#same-name-only').is(':checked')) return true;
      return $(settings.aoData[i].nTr).hasClass('same-name');
    });
    var table = $('#address_results').dataTable();
    $('#same-name-only').on('change', function() { table.fnDraw(); });
  });

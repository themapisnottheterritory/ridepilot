.panel.panel-default
  .panel-heading
    .row
      .col-sm-12
        %h3.panel-title
          .btns.pull-right
            =link_to translate_helper("create_provider_address_text"), '#', id: 'addProviderCommonAddress', class:'btn action-button'
          = translate_helper(:show_provider_address_heading)
          - if ProviderCommonAddress.where(provider: @provider).empty?
            %span.badge
              0
            %i.fa.fa-exclamation-triangle{style: 'color: red'}
  .panel-body
    %p.text-muted{style: "margin: 0 0 10px;"}
      Saved places are shared by everyone who books trips: clinics, stores, employers, offices.
      %b A rider's home goes on the rider's record
      (Customers, the rider, Addresses).
      = link_to "How addresses work (PDF)", "/address-guide.pdf", target: "_blank"
      ·
      = link_to "Pins to check", pin_checks_path
      %span.text-muted (pins far from where drivers stop)
      ·
      = link_to "Name busy places", place_names_path
      %span.text-muted (trip destinations with no name)
      ·
      = link_to "Address check", address_checks_path
      %span.text-muted (pins far from home, on a map; garages that don't fit their runs)
    .row.col-sm-12
      = render 'addresses_table'
    

= render 'add_address_dialog'
-# Only for those who can actually run it. Editors reach this page now, and a
-# submit button that answers "not authorized" is a worse answer than no button.
- if can? :load, ProviderCommonAddress
  = render 'addresses/upload_form', provider: @provider 
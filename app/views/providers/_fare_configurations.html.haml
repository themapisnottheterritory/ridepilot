%h2.section-header#fare_related_settings= translate_helper("fare_related_settings")
- if can? :edit, @provider
  - fare = @provider.fare || @provider.build_fare
  = form_tag change_fare_related_settings_provider_path(@provider) do
    %fieldset
      %ol.section.one
        %li
          = label_tag translate_helper("fare_type")
          = select_tag "fare_type", options_for_select( [["Free", 'free'], ["Donation", 'donation'], ["Payment", 'payment']], fare.fare_type), name: "fare[fare_type]"
        %li{style: (fare.is_free? ? "display: none;" : "") }
          = label_tag translate_helper("pre_or_post_trip")
          = select_tag "pre_or_post_trip", options_for_select( [["Pre-trip", true], ["Post-trip", false]], fare.pre_trip), name: "fare[pre_trip]"
        %li
          = label_tag "provider_fare_udr_default", "Fare card: demand-response fare ($)"
          = number_field_tag "provider[fare_udr_default]", @provider.fare_udr_default, step: 0.01, min: 0, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} charged on a card tap at pickup when the trip has no fare amount of its own
        %li
          = label_tag "provider_fare_paratransit", "Fare card: ADA paratransit fare ($)"
          = number_field_tag "provider[fare_paratransit]", @provider.fare_paratransit, step: 0.01, min: 0, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} flat fare for an ADA-eligible rider whose trip stays inside the urban cities below; 0 turns the rule off
        %li
          = label_tag "provider_fare_urban_cities", "Fare card: urban service area cities"
          = text_field_tag "provider[fare_urban_cities]", @provider.fare_urban_cities, size: 40
          %span.text-muted{style: 'margin-left: 8px;'} comma separated; both ends of the trip must be in one of them
        %li
          = label_tag "provider_fare_monthly_pass_price", "Fare card: monthly pass price ($)"
          = number_field_tag "provider[fare_monthly_pass_price]", @provider.fare_monthly_pass_price, step: 0.01, min: 0, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} 0 hides the Sell monthly button
        %li
          = label_tag "provider_fare_multi_trip_discount_pct", "Fare card: 10 / 20-trip pass discount (%)"
          = number_field_tag "provider[fare_multi_trip_discount_pct]", @provider.fare_multi_trip_discount_pct, step: 1, min: 0, max: 100, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} the card still gets the full trips' value; the rider pays this much less
        %li
          = label_tag "provider_fare_negative_floor", "Fare card: lowest balance allowed ($)"
          = number_field_tag "provider[fare_negative_floor]", @provider.fare_negative_floor, step: 0.01, max: 0, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} 0 refuses a tap that would go negative; -5.00 lets a rider owe up to $5
        %li
          = label_tag "provider_fare_transfer_window_minutes", "Fare card: transfer window (minutes)"
          = number_field_tag "provider[fare_transfer_window_minutes]", @provider.fare_transfer_window_minutes, step: 1, min: 0, style: 'width: 8em;'
          %span.text-muted{style: 'margin-left: 8px;'} a second fixed-route tap inside this window is a free transfer
      .actions
        = submit_tag translate_helper("update_fare_related_settings"), class: 'btn action-button'
%hr

:javascript
  $(function() {
    $('#fare_type').on('change', function() {
      if($(this).val() == 'free') {
        $('#pre_or_post_trip').parents('li').hide();
      } else {
        $('#pre_or_post_trip').parents('li').show();
      }
    });
  });
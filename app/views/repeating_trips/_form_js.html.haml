= render 'shared/hide_invisible_form_fields_js', model_name: "repeatingtrip", table_name: 'repeating_trips', provider_id:  current_provider.try(:id)

-# Before saving, ask if the rider already has a subscription that could be
-# this one (SubscriptionDuplicates). If the check can't be made, save anyway.
:javascript
  function confirm_no_duplicate_subscription(form, callback) {
    var data = $(form).serializeArray().filter(function(f) { return f.name !== '_method'; });
    data.push({ name: 'repeating_trip[id]', value: #{(@trip.id || '').to_json} });
    $.ajax({ type: 'POST', url: #{check_duplicates_repeating_trips_path.to_json}, data: $.param(data), dataType: 'json' })
      .done(function(res) {
        if (!res.trips || !res.trips.length) { callback(); return; }
        var esc = function(v) { return $('<div>').text(v || '').html(); };
        var rows = res.trips.map(function(t) {
          return '<tr><td>' + esc(t.days) + '</td><td>' + esc(t.pickup_time) + '</td><td>' + esc(t.pickup) + '</td><td>' +
                 esc(t.dropoff) + '</td><td>' + esc(t.dates) + '</td></tr>';
        }).join('');
        bootbox.dialog({
          title: '<b>Warning: this rider may already have this subscription</b>',
          message: '<p>This rider already has ' + (res.trips.length == 1 ? 'a subscription' : 'subscriptions') +
                   ' on the same days that could be the same ride:</p>' +
                   '<table class="table table-condensed"><tr><th>Days</th><th>Pickup</th><th>From</th><th>To</th><th>Dates</th></tr>' +
                   rows + '</table><p>Go <b>Back</b> to check, or <b>Save anyway</b> if this is a different ride.</p>',
          buttons: {
            back: { label: 'Back', className: 'btn-default' },
            save: { label: 'Save anyway', className: 'btn-warning', callback: function() { callback(); } }
          }
        });
      })
      .fail(function() { callback(); });
  }

- if !@trip.new_record? && @trip.weekday_assignments.any?
  :javascript
    $(function() {
      function check_run_disruption(callback) {
        var attrs = [];

        var today_str = moment(new Date()).format('YYYY-MM-DD');
        var original_pickup_time = moment(today_str + " #{@trip.pickup_time.try(:to_fs, :time_only)}", "YYYY-MM-DD HH:mm A");
        var new_pickup_time = moment(today_str + " " +$('#repeating_trip_pickup_time').val(), "YYYY-MM-DD HH:mm A");
        if(new_pickup_time - original_pickup_time != 0) {
          attrs.push('pickup time');
        }

        var original_appointment_time = moment(today_str + " #{@trip.appointment_time.try(:to_fs, :time_only)}", "YYYY-MM-DD HH:mm A");
        var new_appointment_time = moment(today_str + " " + $('#repeating_trip_appointment_time').val(), "YYYY-MM-DD HH:mm A");
        if(new_appointment_time - original_appointment_time != 0) {
          attrs.push('appointment time');
        }
        if($('#repeating_trip_pickup_address_id').val() != "#{@trip.pickup_address_id}") {
          attrs.push('pickup address');
        }
        if($('#repeating_trip_dropoff_address_id').val() != "#{@trip.dropoff_address_id}") {
          attrs.push('dropoff address');
        }

        if(attrs.length == 0) {
          if(callback) {
            callback();
          }
        } else {
          bootbox.confirm("<b>Changes in following fields (<span style='color: red;'>" + attrs.join(', ') + "</span>) are likely to disrupt the run and the trip would be unscheduled. Are you sure to continue?</b>", function(result) {
            if(result) {
              if(callback) {
                callback();
              }
            }
          });
        }
      }

      $('.trip_form').submit(function(e) {
        var form = this;
        e.preventDefault();

        var callback = function() {
          handle_client_code_verification($('#repeating_trip_customer_id').val(), form);
        };
        // the duplicate question, then the run disruption warning
        confirm_no_duplicate_subscription(form, function() {
          if(typeof check_run_disruption != 'undefined') {
            check_run_disruption(callback);
          } else {
            callback();
          }
        });

      });
    });
- else
  :javascript
    $(function() {
      $('.trip_form').submit(function(e) {
        var form = this;
        e.preventDefault();
        confirm_no_duplicate_subscription(form, function() {
          handle_client_code_verification($('#repeating_trip_customer_id').val(), form);
        });
      });
    });
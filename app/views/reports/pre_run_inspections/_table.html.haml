- if @report_data.empty?
  %h4 No record found
- else
  %h2 Below is the list of failed inspections:
  - @report_data.each do |vehicle_id, vehicle_data|
    %h4 
      %u= "Vehicle: #{@vehicle_names[vehicle_id]}"
    - vehicle_data.each do |run_id, inspections|
      - run_data = @run_data[run_id]
      %b= "#{run_data[0]}, #{format_date(run_data[1])}"
      %ul
        - inspections.each do |insp|
          %li
            = insp[:description]
            - if insp[:phase].present?
              %em= " (#{insp[:phase]}-trip)"
            - if insp[:photo_count].to_i > 0
              = " · #{insp[:photo_count]} #{'photo'.pluralize(insp[:photo_count].to_i)}"
              - if insp[:photos].present?
                %div{style: 'margin: 4px 0;'}
                  - insp[:photos].each do |photo|
                    - if request.format.html?
                      = link_to image_tag(rails_blob_path(photo, only_path: true), style: 'max-height: 110px; margin: 3px; border: 1px solid #ccc;'), rails_blob_path(photo, only_path: true), target: '_blank'
                    - elsif photo.blob.content_type.to_s.start_with?('image/')
                      -# PDF: wkhtmltopdf can't fetch the blob URL, so embed the image inline as a data URI
                      = image_tag "data:#{photo.blob.content_type};base64,#{Base64.strict_encode64(photo.blob.download)}", style: 'max-height: 220px; margin: 3px; border: 1px solid #ccc;'
            - if insp[:defect_note].present?
              %div
                %b Note:
                = insp[:defect_note]
        - driver_notes = run_data[2]
        - if driver_notes
          %li
            %b Driver Notes: 
            = "#{driver_notes}"


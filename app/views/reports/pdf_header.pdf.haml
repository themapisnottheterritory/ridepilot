%div{style: "font-family: 'Open Sans','DejaVu Sans',sans-serif; border-bottom: 1px solid #CC9900; padding-bottom: 3px; font-size: 9px; color: #12264F;"}
  %span{style: "font-weight: bold;"}= @custom_report.display_name
  - if @report_params && @report_params.any?
    %span{style: "float: right; color: #555; font-weight: normal;"}
      = @report_params.map { |name, label| "#{name}: #{label}" }.join("  |  ")

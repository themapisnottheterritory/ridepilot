- # common
= render 'reports/common_csv_header'

- if @report_data.blank?
  = CSV.generate_line(["No fares recorded in this range"], row_sep: nil).html_safe
- else
  - @agency_sections.each do |a|
    - t = a[:total]
    = CSV.generate_line([a[:agency], "Fares", t[:count], "Cash", t[:cash].round(2), "Fare card", t[:card].round(2), "Passes", t[:passes], "Total", t[:total].round(2)], row_sep: nil).html_safe
  - if @by_agency
    = CSV.generate_line(["All agencies", "Fares", @grand[:count], "Cash", @grand[:cash].round(2), "Fare card", @grand[:card].round(2), "Passes", @grand[:passes], "Total", @grand[:total].round(2)], row_sep: nil).html_safe
  = CSV.generate_line(["Agency", "Collected", "Run", "Driver", "Rider", "Funding source", "Paid by", "Amount", "Trip"], row_sep: nil).html_safe
  - @fares.sort_by { |f| [f[:agency].to_s, f[:collected_at]] }.each do |f|
    = CSV.generate_line([f[:agency], f[:collected_at].strftime('%m/%d/%Y %H:%M'), f[:run], f[:driver], f[:rider], f[:funding], f[:paid_by], f[:amount].round(2), f[:trip].id], row_sep: nil).html_safe

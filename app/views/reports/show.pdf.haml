:css
  @import url('https://fonts.googleapis.com/css?family=Open+Sans:400,600,700,800&subset=latin-ext');
  body { font-family: 'Open Sans','DejaVu Sans',sans-serif; color:#131313; font-size:11px; }
  /* GCRPC brand masthead (rendered once at the top) */
  .gcrpc-masthead { border-bottom:3px solid #CC9900; padding-bottom:8px; margin-bottom:16px; }
  .gcrpc-masthead .gcrpc-seal { height:70px; width:70px; float:left; margin-right:15px; }
  .gcrpc-masthead .gcrpc-titles { overflow:hidden; padding-top:8px; }
  .gcrpc-masthead .gcrpc-org { font-family:'Copperplate Gothic Bold','Copperplate','DejaVu Serif',serif; color:#12264F; font-size:20px; font-weight:bold; line-height:1.15; }
  .gcrpc-masthead .gcrpc-report { color:#12264F; font-size:15px; margin-top:2px; }
  /* vehicle section heading */
  .vehicle-heading { font-size:18px; margin-bottom:2px; }
  .vehicle-heading .vehicle-plate { font-family:'Open Sans','DejaVu Sans',sans-serif; color:#12264F; font-weight:600; }
  /* headings (covers list-style reports) */
  h1,h2,h3,h4,h5 { font-family:'Copperplate Gothic Bold','Copperplate','DejaVu Serif',serif; color:#12264F; }
  h2 { border-bottom:2px solid #CC9900; padding-bottom:3px; }
  u { text-decoration:none; color:#12264F; font-weight:bold; }
  /* branded tables (scoped to bootstrap .table so manifest's custom tables are untouched) */
  table.table { width:100%; border-collapse:collapse; }
  table.table th { background:#12264F; color:#fff; font-weight:600; text-align:left; padding:5px 7px; border:1px solid #12264F; font-family:'Open Sans','DejaVu Sans',sans-serif; font-size:10px; }
  table.table td { padding:4px 7px; border:1px solid #cfd6e4; font-size:10px; }
  table.table tbody tr:nth-child(even) td { background:#f4f6fa; }
  /* page-break behavior (previously in pdf.css, which the layout no longer applies) */
  thead { display: table-header-group; }
  tr { page-break-inside: avoid !important; }
.gcrpc-masthead
  = image_tag "data:image/png;base64,#{Base64.strict_encode64(File.binread(Rails.root.join('app/assets/images/gcrpc-logo.png')))}", class: "gcrpc-seal", alt: "GCRPC"
  .gcrpc-titles
    .gcrpc-org Golden Crescent Regional Planning Commission
    - if defined?(@custom_report) && @custom_report
      .gcrpc-report= @custom_report.display_name
= render "reports/#{@custom_report.name}/pdf"

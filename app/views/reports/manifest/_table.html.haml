:css
  table {
    border: none;
  }

  table th {
    background: white;
    color: black;
    border-top: 2px black solid;
    border-bottom: 2px black solid;
  }

  tr.odd {
    background: white;
  }

  @media print {
    table td, table th{
      border: none;
    }

    .page-break {
      page-break-before: always;
    }
  }
  
  p {
    line-height: normal;
  }

  table td, table th {
    padding: 4px;
  }

.col-sm-12.col-md-10.col-md-offset-1.col-lg-8.col-lg-offset-2
  - @runs.each_with_index do |run, index|
    .page-break{style: (index == 0 ? "page-break-before: auto;" : "")}
    .row
      .col-xs-6{style: 'font-size: 18px; font-weight: bold; padding-left: 0px;'}
        .col-sm-12{style: 'padding-left: 0px;'}
          = "#{translate_helper('driver_manifest_date')}: #{run.date.strftime('%A')}"
        .col-sm-12{style: 'padding-left: 0px;'}
          = format_date(run.date)
      .col-xs-6{style: 'padding-right: 0px;'}
        .pull-right
          -# The GCRPC seal is square; the UTA mark it replaces was a 151x40
          -# banner, and reusing those dimensions would have squashed it. 70x70
          -# is the size the seal already runs at on the custom report masthead.
          - if @is_pdf
            = wicked_pdf_image_tag "/gcrpc-logo.png", height:70, width:70, alt: "GCRPC"
          - else
            %img{src: "/gcrpc-logo.png", height:70, width:70, alt: "GCRPC"}
          
    %br  
    = render partial: "reports/manifest/run", formats: [:html], locals: {run: run}


       

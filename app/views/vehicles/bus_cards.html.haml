-# Bus cards to print and laminate (VehiclesController#bus_card / #bus_cards):
-# credit-card size, 8 to a letter page, dashed cut lines. The QR holds
-# Vehicle#bus_card_code, printed under it too for typing by hand.
- short = { "Victoria Transit GCRPC" => "GCRPC · Victoria Transit" }
.bc-toolbar.hidden-print
  %button.btn.btn-primary{onclick: 'window.print()'} Print
  %span= "#{@cards.size} bus card#{'s' if @cards.size != 1} · print at 100% (Actual size), then cut on the dashed lines and laminate."
.bc-sheet
  - @cards.each do |v|
    - agency = v.provider&.name.to_s
    .bc-card
      .bc-band
        %span.bc-agency= short[agency] || agency
        %span.bc-tag BUS CARD
      .bc-body
        .bc-qr
          = RQRCode::QRCode.new(v.bus_card_code, level: :m).as_svg(module_size: 4, offset: 12, standalone: true, use_path: true, viewbox: true).html_safe
          .bc-code= v.bus_card_code
        .bc-text
          .bc-unit UNIT
          .bc-name{class: ('bc-long' if v.name.to_s.length > 6)}= v.name
          .bc-hint
            Scan at the start of every run.
            %br
            Keep on this bus.
:css
  @page { size: letter; margin: 0.5in 0.4in; }
  body { background: #fff; }
  .bc-toolbar { padding: 12px 18px; font-family: Helvetica, Arial, sans-serif; font-size: 13px; color: #5f6b7a; }
  .bc-toolbar .btn { margin-right: 10px; }
  .bc-sheet { display: grid; grid-template-columns: repeat(2, 3.375in); gap: 0.25in; justify-content: center; padding: 0.1in 0; }
  .bc-card { width: 3.375in; height: 2.125in; box-sizing: border-box; border: 1px dashed #c8cfdb; border-radius: 8px; overflow: hidden; font-family: Helvetica, Arial, sans-serif; break-inside: avoid; page-break-inside: avoid; }
  .bc-band { background: #12264F; color: #fff; height: 0.35in; display: flex; align-items: center; justify-content: space-between; padding: 0 0.14in; font-weight: 700; font-size: 9pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .bc-tag { color: #CC9900; font-size: 8pt; }
  .bc-body { display: flex; align-items: flex-start; padding: 0.02in 0.06in 0; }
  .bc-qr { width: 1.45in; text-align: center; }
  .bc-qr svg { width: 1.45in; height: 1.45in; display: block; background: #fff; }
  .bc-code { font-size: 7pt; color: #5f6b7a; margin-top: 0; }
  .bc-text { padding-left: 0.12in; padding-top: 0.08in; min-width: 0; }
  .bc-unit { font-size: 8pt; font-weight: 700; color: #5f6b7a; }
  .bc-name { font-size: 40pt; font-weight: 700; color: #12264F; line-height: 1; white-space: nowrap; }
  .bc-name.bc-long { font-size: 24pt; }
  .bc-hint { font-size: 7.5pt; color: #5f6b7a; margin-top: 0.12in; line-height: 1.3; }
  .bc-card:nth-child(8n) { page-break-after: always; break-after: page; }
  @media print { .hidden-print { display: none; } }

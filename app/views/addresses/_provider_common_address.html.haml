%tr
  %td
    = address.address_group.try(:name)
  %td.name
    = link_to_if can?(:edit, ProviderCommonAddress), address.name || '' , edit_provider_common_address_path(address)
  %td= address.coded_by_lat_lng? ? address.address_text : address.address
  %td= address.city
  %td= address.county
  %td= format_phone_number address.phone_number
  -# Three states, not two. The edit form offers Unspecified / Yes / No, and 2,781
  -# of the 2,788 provider addresses are Unspecified -- none is actually No. Folding
  -# nil in with false told the table to report them all as Out of District, which
  -# is an answer nobody gave.
  %td
    - if address.in_district.nil?
      = translate_helper("unspecified")
    - else
      = address.in_district? ? translate_helper("in_district") : translate_helper("out_of_district")
  %td= address.notes
  - if can? :edit, Address
    %td= link_to translate_helper("edit"), edit_provider_common_address_path(address), :class=>'edit edit-address'
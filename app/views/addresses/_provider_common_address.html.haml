-# Lists render this once per address (2,400+ on the provider page), so the labels and
-# permission checks come in precomputed as row_context rather than being looked up per row --
-# each translate_helper is several DB-backed lookups. Callers without it still work.
- ctx = local_assigns[:row_context] || provider_common_address_row_context
%tr
  %td
    = address.address_group.try(:name)
  %td.name
    = link_to_if ctx[:can_edit_common], address.name || '' , edit_provider_common_address_path(address)
    - if address.the_geom.nil?
      %span.label.label-danger.not-on-map{title: "No map location, so this address won't come up when booking trips"} Not on map
  %td= address.coded_by_lat_lng? ? address.address_text : address.address
  %td= address.city
  %td= address.county
  %td= format_phone_number address.phone_number
  -# Three states, not two. The edit form offers Unspecified / Yes / No, and 2,781
  -# of the 2,788 provider addresses are Unspecified -- none is actually No. Folding
  -# nil in with false told the table to report them all as Out of District, which
  -# is an answer nobody gave.
  %td
    - if address.in_district.nil?
      = ctx[:unspecified]
    - else
      = address.in_district? ? ctx[:in_district] : ctx[:out_of_district]
  %td= address.notes
  - if ctx[:can_edit_address]
    %td= link_to ctx[:edit], edit_provider_common_address_path(address), :class=>'edit edit-address'

<script type='text/javascript'>

  function populate_address_form(field, address) {
    if(!address) {
      return;
    }
    form = $("#" + field + "-address-form");
    form.find('#address_id').val(address.id);
    form.find('#' + field + '_name').val(address.name);
    //form.find('#' + field + '_building_name').val(address.building_name);
    form.find('#' + field + '_address').val(address.address);
    form.find('#' + field + '_full_address').val(address.label);
    form.find('#' + field + '_city').val(address.city);
    form.find('#' + field + '_state').val(address.state);
    form.find('#' + field + '_zip').val(address.zip);
    form.find('#' + field + '_lat').val(address.lat);
    form.find('#' + field + '_lon').val(address.lon);
    // The hidden lat/lon the validate action reads (hidden_field_tag :lat/:lon).
    form.find('.address_lat').val(address.latitude);
    form.find('.address_lon').val(address.longitude);
    form.find('#' + field + '_phone_number').val(address.phone_number);
    form.find('#' + field + '_trip_purpose_id').val(address.trip_purpose_id);
    var in_district = [true, false].indexOf(address.in_district) >= 0 ? address.in_district.toString() : '';
    form.find('#' + field + '_in_district').val(in_district);
    form.find('#' + field + '_notes').val(address.notes);

    if(address.coded_by_lat_lng) {
      form.find('.latlng_address_switch').prop('checked', true).trigger('change');
      form.find('input[name=address_lat]').val(address.latitude);
      form.find('input[name=address_lon]').val(address.longitude);
    } else {
      form.find('.latlng_address_switch').prop('checked', false).trigger('change');
    }
  }

  function updateAddressRow(addressData, addressText) {
    var encodedAddressData = JSON.stringify(addressData);

    var table = $('#customerCommonAddressTable');
    // Rows are compared by value, never by a quoted selector: an address with
    // an apostrophe ("Port O'Connor", as the map spells it) broke the selector,
    // the row was never updated, and the rider was saved with the old, unpinned
    // address while the dialog looked fine (2026-10-07).
    var rowsWithText = function() {
      return table.find('tbody tr').filter(function() { return $(this).attr('data-address-text') === addressText; });
    };
    var nameCell = function() {
      return $("<td class='address_name'></td>").text(addressData.name || '').append('&nbsp;', $('<a class="viewAddress" href="#"></a>').text('(Edit details)'));
    };

    // An existing address edited in the dialog keeps its own row, found by
    // id. Matching on the text alone added a second row whenever the street
    // changed ("510 S Front St" -> "510 South Front Street"), and saving the
    // customer then wrote that address twice and failed (2026-10-05).
    var idRow = addressData.id ? table.find('tbody tr').filter(function() { return String($(this).attr('data-address-id')) === String(addressData.id); }) : $();
    if(idRow.length > 0) {
      if(rowsWithText().not(idRow).length > 0) {
        show_alert("<%= translate_helper(:same_address_exists_for_customer) %>");
        return;
      }
      idRow.data('address', addressData);
      idRow.attr('data-address', encodedAddressData);
      idRow.attr('data-address-text', addressText);
      idRow.find('td.address_name').replaceWith(nameCell());
      idRow.find('td.address_text').text(addressText);
      return;
    }

    var matchRow = rowsWithText();
    if(matchRow.length > 0) {
      var addressId = matchRow.attr('data-address-id');
      if(addressId && parseInt(addressId) != addressData.id){
        show_alert("<%= translate_helper(:same_address_exists_for_customer) %>");
      } else {
        matchRow.data('address', addressData);
        matchRow.attr('data-address', encodedAddressData);
        matchRow.find('td.address_name').replaceWith(nameCell());
      }
    } else {
      var row = $('<tr></tr>')
        .attr('data-address-id', addressData.id == null ? '' : addressData.id)
        .attr('data-address-text', addressText)
        .attr('data-address', encodedAddressData)
        .data('address', addressData);
      row.append($('<td></td>').append('<button class="deleteCustomerAddress btn-danger" name="button" type="button">Delete</button>'));
      row.append(nameCell());
      row.append($("<td class='address_text'></td>").text(addressText));
      row.append('<td><input name="mailing" type="radio" value=false></td>');
      table.append(row);
    }
  }

  $(document).ready(function() {
    
    // happens after you submit an address (not autocomplete)
    // an id should be returned, and then the form should close.
    // if no id is returned, error messages are filled in. 
    $("body").on('ajax:success', '.address-validate', function(evt, data, status, xhr){
        console.log('test');
      if (data.no_pin_warning) {
        // AddressesController#validate_customer_specific: no map pin yet
        var f = $(this);
        f.find('.home-warn').remove();
        var box = $('<div class="home-warn" style="background:#fbf7ea;border-left:4px solid #CC9900;border-radius:0 6px 6px 0;padding:10px 14px;margin:0 0 12px;font-size:14px;"></div>');
        if (data.street_not_found) {
          box.append('<div><b style="color:#12264F">RidePilot couldn\'t find that street either.</b> Check the street name and town, pick it from the suggestions, or save it without a pin and ask GCRPC I.T. to place it.</div>');
        } else {
          box.append('<div><b style="color:#12264F">Not on the map yet,</b> so it won\'t come up when booking. Pick it from the suggestions, or let RidePilot <b>place it on the map</b>: it looks up the house (on our map, then with the US Census), or at least the street, and keeps the address you typed.</div>');
        }
        var btns = $('<div style="margin-top:8px; display:flex; gap:8px; flex-wrap:wrap;"></div>');
        var send = function(flag) {
          f.find('input[name=no_pin_ok], input[name=place_on_street]').remove();
          f.append('<input type="hidden" name="' + flag + '" value="1">');
          f.trigger('submit');
        };
        if (!data.street_not_found) {
          btns.append($('<button type="button" class="btn action-button"></button>').text('Place it on the map').on('click', function() { send('place_on_street'); }));
        }
        btns.append($('<button type="button" class="btn btn-default"></button>').text('Save it without a pin anyway').on('click', function() { send('no_pin_ok'); }));
        box.append(btns);
        f.prepend(box);
        return;
      }
      $(this).find('.home-warn').remove();
      if (data.success) {
        $('#addAddressDialog').modal('hide');
        if (data.placed_on_street) {
          show_alert(data.placed_on_street == "house"
            ? "Placed on the map at the house. Save the rider to keep it."
            : "Placed on the street: RidePilot found the street but not the house, so the pin may be some way along it. Check the pin on the map, move it to the house if you can, and save the rider.");
        }

        //insert a new address row
        updateAddressRow(data.attributes, data.address_text);
        
      } else {
        showAddressValidationErrors(this, data);
      }
    })
    
    // address dialog functionality
    // via http://jqueryui.com/demos/dialog/#modal-form 
    function makeDialogs() {
      $( ".address-form" ).dialog({
          autoOpen: false,
          height: 395,
          width: 600,
          modal: true,
          buttons: {
              "Save": function() {
                  form = $( this )[0].children[0];
                  $(form).trigger('submit'); 
              },
              "Cancel": function() {
                $( this ).dialog( "close" );
              }
          }
      });
    };
    
    //makeDialogs();
  });
</script>
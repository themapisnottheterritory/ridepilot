-# The customer's next 10 and last 10 trips, side by side (CustomerTrips).
-# Kristie remembered a "last ten / next ten" view; the old one is Trip
-# Summary on the trip form, one or the other at a time.
- ct = CustomerTrips.new(@customer)
- coming, recent = ct.coming.to_a, ct.recent.to_a
:css
  .ct-panel table { width: 100%; margin: 0; font-size: 12.5px; }
  .ct-panel th { font-size: 11px; color: #5f6b7a; font-weight: 600; text-transform: uppercase; padding: 6px 8px 4px; }
  .ct-panel td { padding: 5px 8px; border-top: 1px solid #eef1f6; vertical-align: top; }
  .ct-panel td.when { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ct-panel .muted { color: #5f6b7a; }
  .ct-panel .sub { color: #5f6b7a; font-size: 11.5px; }
  .ct-badge { display: inline-block; font-size: 11px; font-weight: 700; border-radius: 3px; padding: 0 5px; white-space: nowrap; }
  .ct-badge.run { background: #12264F; color: #fff; }
  .ct-badge.wait { border: 1px solid #CC9900; color: #8a5a00; }
  .ct-badge.done { background: #e6f6e6; color: #0a7a0a; border: 1px solid #0ca30c; }
  .ct-badge.off { border: 1px solid #cfd6e4; color: #5f6b7a; }
  .ct-panel h4 { font-size: 13px; font-weight: 700; color: #12264F; margin: 10px 8px 2px; }
.panel.panel-primary.ct-panel#customer_trips_overview
  .panel-heading
    %h3.panel-title Trips
  .panel-body{style: "padding: 0 0 6px;"}
    - [["Coming up", coming, "No trips booked from now on."], ["Recent", recent, "No trips yet."]].each do |title, trips, none|
      %h4= title
      - if trips.empty?
        %p.muted{style: "margin: 2px 8px 6px;"}= none
      - else
        %table
          - trips.each do |trip|
            %tr
              %td.when
                = link_to trip.pickup_time.strftime("%a %-m/%-d"), trip_path(trip), title: "Open this trip"
                .sub= trip.pickup_time.strftime("%-l:%M %p")
              %td
                = "#{trip_place_label(trip.pickup_address)} → #{trip_place_label(trip.dropoff_address)}"
                - if trip.appointment_time
                  .sub= "appointment #{trip.appointment_time.strftime('%-l:%M %p')}"
              %td{style: "text-align: right;"}= trip_state_badge(trip)

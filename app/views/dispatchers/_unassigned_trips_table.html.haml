-# Area filter (ServiceArea, Kristie 2026-10-02): the area the rider lives in; buttons filter, the
-# Area heading sorts by area then pickup time. The choice is remembered per browser.
- if current_provider&.id == ServiceArea::PROVIDER_ID
  #area_filter{style: 'margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center;'}
    %span.text-muted{style: 'font-size: 12px; margin-right: 4px;'} Area:
%table.table.table-striped#unassigned_trips_table
  %thead
    %tr
      %th
        %input#unassigned_trips_master_checkbox{type: "checkbox"}
      - if current_provider&.id == ServiceArea::PROVIDER_ID
        %th#area_sort{style: 'cursor: pointer; white-space: nowrap;', title: 'Sort by area, then pickup time'} Area ↕
      %th= translate_helper(:unassigned_trips_table_header_customer)
      %th= translate_helper(:unassigned_trips_table_header_phone)
      %th= translate_helper(:unassigned_trips_table_header_pickup_time)
      %th= translate_helper(:unassigned_trips_table_header_appointment_time)
      %th= translate_helper(:unassigned_trips_table_header_pickup_address)
      %th= translate_helper(:unassigned_trips_table_header_dropoff_address)
      %th= translate_helper(:unassigned_trips_table_header_riders_count)
      %th= translate_helper(:unassigned_trips_table_header_fare)
      %th= translate_helper(:unassigned_trips_table_header_comments)
      %th= translate_helper(:unassigned_trips_table_header_actions)
  %tbody
    - fare_schedule = FareSchedule.new(current_provider)
    - trips.each do |trip|
      %tr{data: {trip_id: trip.id, area: trip.service_area.presence || 'NONE', pickup: trip.pickup_time.to_i}}
        %td
          %input.trip-selected{type: "checkbox"}
        - if current_provider&.id == ServiceArea::PROVIDER_ID
          %td{style: 'white-space: nowrap;'}
            - if trip.service_area.present?
              %span.label{class: "area-#{trip.service_area}", title: ServiceArea.label(trip.service_area)}= trip.service_area == 'OUT' ? 'Out' : (trip.service_area == 'NOPIN' ? 'No pin' : trip.service_area)
              - if trip.service_area_note.present?
                %div{style: 'font-size: 11px; color: #5f6b7a;'}= trip.service_area_note
        %td
          = mobility_icon(trip)
          %span{data: {customer_card: trip.customer_id}}= trip.customer.try(:name)
          - if trip.repeating_trip_id.present?
            %span.label.label-info.pull-right
              Recur
          = will_call_label(trip)
        %td= simple_format [trip.customer.phone_number_1, trip.customer.phone_number_2].compact.join('<br>')
        %td= format_time_for_listing(trip.pickup_time)
        %td= format_time_for_listing(trip.appointment_time) if trip.appointment_time
        %td= trip.pickup_address.try(:one_line_text)
        %td= trip.dropoff_address.try(:one_line_text)
        %td
          = trip.trip_size
          - if trip.ridership_mobilities.has_capacity.empty?
            %span.label.label-danger.pull-right
              Mobility?
        -# The fare to quote a cash rider (county fare tables); blank until the trip has a distance.
        %td
          - if (quote = TripFareQuote.new(trip, schedule: fare_schedule, compute_distance: false).call)&.no_fare
            %span{title: quote.basis} no fare
          - elsif quote
            %span{title: [quote.basis, quote.category&.name].compact.join(' · ')}= number_to_currency(quote.amount)
            - if quote.category_assumed
              %span.text-warning{title: 'No fare category on the customer: Adult fare shown'} *
        %td= trip.notes
        %td
          = link_to trip_path(trip, from_dispatch: true), style: 'padding-right: 5px;', title: "View details" do 
            %i.fas.fa-external-link-alt
          - if can?(:edit, trip)
            = link_to edit_trip_path(trip, from_dispatch: true), style: 'padding-right: 5px;', title: 'Edit' do 
              %i.fas.fa-pencil-alt

:css
  #unassigned_trips_table .label[class*="area-"] { background: #12264F; font-size: 11px; }
  #unassigned_trips_table .label.area-OUT { background: #fff; color: #5f6b7a; border: 1px solid #5f6b7a; }
  #unassigned_trips_table .label.area-NOPIN { background: #fff; color: #d03b3b; border: 1px solid #d03b3b; }
  #area_filter button { font-size: 12px; padding: 2px 10px; border-radius: 999px; border: 1px solid #12264F; background: #fff; color: #12264F; }
  #area_filter button.on { background: #12264F; color: #fff; }
:javascript
  $(function() {
    configure_unassigned_trips_table();

    // Area buttons: built from the trips in the list, with counts; the choice is kept per browser.
    var bar = $('#area_filter');
    if (!bar.length) return;
    var KEY = 'dispatch-area-filter', SORT = 'dispatch-area-sort';
    var get = function(k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
    var put = function(k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
    var order = #{(ServiceArea::CODES + ['NONE']).to_json};
    var names = { OUT: 'Out of area', NOPIN: 'No pin', NONE: 'Not tagged' };
    var rows = $('#unassigned_trips_table tbody tr');
    var counts = {};
    rows.each(function() { var a = $(this).data('area'); counts[a] = (counts[a] || 0) + 1; });
    var current = get(KEY) || 'ALL';
    if (current !== 'ALL' && !counts[current]) current = 'ALL';
    function apply() {
      rows.each(function() { $(this).toggle(current === 'ALL' || $(this).data('area') === current); });
      bar.find('button').removeClass('on').filter('[data-a="' + current + '"]').addClass('on');
      var t = $('#unassigned_trips_table'); if (t.floatThead) { try { t.floatThead('reflow'); } catch (e) {} }
    }
    function btn(code, text) {
      return $('<button type="button"></button>').attr('data-a', code).text(text).on('click', function() { current = code; put(KEY, code); apply(); });
    }
    bar.append(btn('ALL', 'All ' + rows.length));
    order.forEach(function(code) { if (counts[code]) bar.append(btn(code, (names[code] || code) + ' ' + counts[code])); });
    function sortByArea() {
      var tbody = $('#unassigned_trips_table tbody');
      var sorted = rows.get().sort(function(a, b) {
        var ai = order.indexOf($(a).data('area')), bi = order.indexOf($(b).data('area'));
        return ai - bi || ($(a).data('pickup') - $(b).data('pickup'));
      });
      $.each(sorted, function(_, r) { tbody.append(r); });
    }
    $('#area_sort').on('click', function() { var on = get(SORT) !== '1'; put(SORT, on ? '1' : '0'); if (on) sortByArea(); else location.reload(); });
    if (get(SORT) === '1') sortByArea();
    apply();
  });